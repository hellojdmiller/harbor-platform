{
  "name": "harbor-platform",
  "version": "0.1.0",
  "private": true,
  "description": "An open enterprise platform for personal AI assistants.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "deploy:vercel": "convex deploy --cmd 'npm run build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
    "doctor": "tsx scripts/doctor.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.4",
    "@convex-dev/workflow": "0.4.8",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@vercel/otel": "2.1.3",
    "convex": "1.46.0",
    "geist": "1.7.2",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svix": "2.5.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "convex-test": "0.0.59",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "type": "module"
}
