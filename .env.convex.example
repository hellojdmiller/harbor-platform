# Set these on the CONVEX deployment, not NEXT_PUBLIC_ variables.
OIDC_ISSUER=
OIDC_AUDIENCE=convex
ANTHROPIC_API_KEY=
# See docs/providers-integrations.md for the validated model catalog format.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Production admission is denied by default. Use exact OIDC subjects, not emails.
HARBOR_BOOTSTRAP_SUBJECTS=[]
# Development ONLY; leave unset in production and previews.
HARBOR_ALLOW_SELF_SERVICE_WORKSPACES=false
RESEND_FROM=
ENABLE_EXTERNAL_WRITES=false
